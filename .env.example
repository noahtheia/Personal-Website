# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Resend Audience ID — create one at https://resend.com/audiences
RESEND_AUDIENCE_ID=

# Verified sender (must be on a domain you've verified in Resend)
# e.g. "Noah <newsletter@yourdomain.com>"
NEWSLETTER_FROM="Noah <newsletter@example.com>"

# Public site URL — used in newsletter links.
# Set to your Vercel deployment URL or custom domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin portal (production only — local dev writes to the filesystem and
#     skips auth entirely).
# The password you'll type on /admin/login.
ADMIN_PASSWORD=
# 32+ random chars — used to HMAC-sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Fine-grained GitHub PAT with `contents: write` on the repo below.
# Create at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# The repo that admin saves commit into.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
