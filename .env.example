# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Resend Audience ID — create one at https://resend.com/audiences
RESEND_AUDIENCE_ID=

# Verified sender (must be on a domain you've verified in Resend)
# e.g. "Noah <newsletter@yourdomain.com>"
NEWSLETTER_FROM="Noah <newsletter@example.com>"

# Public site URL — used in newsletter links AND the admin OAuth callback.
# Set to your Vercel deployment URL or custom domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin portal (production only — local dev writes to the filesystem and
#     skips OAuth entirely). Create a GitHub OAuth App and a long random
#     ADMIN_SESSION_SECRET; see the admin README for the walkthrough.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub username allowed to sign in to /admin (single allowlist entry).
ADMIN_GITHUB_USER=
# 32+ random chars — used to HMAC-sign the admin session cookie.
# Generate with: openssl rand -hex 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SESSION_SECRET=
# The repo that admin saves commit into.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
